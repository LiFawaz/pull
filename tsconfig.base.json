{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@valenced/types", "react"]
  },
  "include": ["plugins/pull/**/*"],
  "exclude": ["**/build", "**/node_modules"]
}
